diff --git a/common/event-queue/EventList.cpp b/common/event-queue/EventList.cpp
index a1c09ec..547ff29 100644
--- a/common/event-queue/EventList.cpp
+++ b/common/event-queue/EventList.cpp
@@ -12,24 +12,35 @@ EventList::EventList(const EventTime event_time) noexcept : event_time(event_tim
     assert(event_time >= 0);
 
     // create an empty event list
-    events = std::list<Event>();
+    events = std::list<std::pair<int, Event>>();
 }
 
 EventTime EventList::get_event_time() const noexcept {
     return event_time;
 }
 
-void EventList::add_event(const Callback callback, const CallbackArg callback_arg) noexcept {
+void EventList::add_event(const Callback callback, const CallbackArg callback_arg, int phase) noexcept {
     assert(callback != nullptr);
 
     // add the event to the event list
-    events.emplace_back(callback, callback_arg);
+    auto pos = events.begin();
+    while (pos != events.end() && pos->first <= phase) ++pos;
+    events.emplace(pos, phase, Event(callback, callback_arg));
 }
 
 void EventList::invoke_events() noexcept {
     // invoke all events in the event list
     while (!events.empty()) {
-        events.front().invoke_event();
+        // Pop before invoking: cancellation may remove other entries at this tick.
+        auto event = events.front().second;
         events.pop_front();
+        event.invoke_event();
+    }
+}
+
+void EventList::cancel_if(const std::function<bool(Callback, CallbackArg)>& predicate) {
+    for (auto it = events.begin(); it != events.end();) {
+        auto [callback, arg] = it->second.get_handler_arg();
+        if (predicate(callback, arg)) it = events.erase(it); else ++it;
     }
 }
